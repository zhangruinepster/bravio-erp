# Bravio ERP 环境配置示例

# 运行模式: development / production
ENVIRONMENT=development
DEBUG=True

# 安全密钥 (生产环境务必替换为高强度随机字符串)
SECRET_KEY=bravio-erp-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 数据库连接
# 本地免安装轻量开发模式 (默认无需安装外部数据库):
DATABASE_URL=sqlite+aiosqlite:///./erp_dev.db

# 容器化 / 生产环境 PostgreSQL 连接示例:
# DATABASE_URL=postgresql+asyncpg://bravio_admin:bravio_secret_2026@localhost:5432/bravio_erp

# Redis 缓存连接 (可选)
# REDIS_URL=redis://localhost:6379/0

# 开发者日志配置
LOG_LEVEL=DEBUG
LOG_DIR=logs
